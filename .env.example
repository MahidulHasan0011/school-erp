# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- App ---
PORT=3000
NODE_ENV=development
GLOBAL_PREFIX=your-api-prefix

# --- JWT ---
JWT_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-refresh-secret
JWT_EXPIRES_IN=your-access-token-expiration
JWT_REFRESH_EXPIRES_IN=your-refresh-token-expiration

# --- Redis (auth session / token revocation) ---
REDIS_HOST=your-redis-host
REDIS_PORT=your-redis-port
REDIS_PASSWORD=your-redis-password
# cloud Redis (Upstash/etc.) হলে true
REDIS_TLS=your-redis-tls-setting(EX: true/false)

# --- RabbitMQ (ranking background jobs) ---
RABBITMQ_URL=your-rabbitmq-url
RABBITMQ_PREFETCH=your-rabbitmq-prefetch-count
RABBITMQ_MAX_DELAY_MS=your-rabbitmq-max-delay-ms

# --- S3 / MinIO (file uploads, presigned URL) ---
# লোকাল MinIO (docker-compose) — endpoint দিলে path-style ব্যবহার হয়।
# AWS S3 হলে S3_ENDPOINT ফাঁকা রাখুন এবং আসল region/bucket দিন।
S3_ENDPOINT=Your-S3-or-MinIO-endpoint
S3_REGION=Your-S3-or-MinIO-region
S3_BUCKET=Your-S3-or-MinIO-bucket-name
S3_ACCESS_KEY_ID=Your-S3-or-MinIO-access-key
S3_SECRET_ACCESS_KEY=Your-S3-or-MinIO-secret-access-key
S3_PUBLIC_URL=Your-S3-or-MinIO-public-url